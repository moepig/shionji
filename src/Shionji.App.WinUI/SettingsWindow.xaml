<Window
    x:Class="Shionji.App.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shionji.App.WinUI">

    <!-- Window 自体の背景はテーマ指定に追従しないため、根に明示する -->
    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:EnumIndexConverter x:Key="EnumIndex" />

            <Style x:Key="SettingsSectionStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <Style x:Key="HintStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Spacing="10">

                <TextBlock Text="表示" Style="{StaticResource SettingsSectionStyle}" />
                <ComboBox Header="カラーテーマ" MinWidth="240"
                          SelectedIndex="{Binding Theme, Mode=TwoWay, Converter={StaticResource EnumIndex}, ConverterParameter=AppTheme}">
                    <ComboBoxItem Content="システムに従う" />
                    <ComboBoxItem Content="ライト" />
                    <ComboBoxItem Content="ダーク" />
                </ComboBox>
                <TextBlock Text="選ぶとすぐに反映されます。" Style="{StaticResource HintStyle}" />

                <TextBlock Text="ログ" Style="{StaticResource SettingsSectionStyle}" />
                <TextBox Header="ログファイルの保存先 (空で既定)" Text="{Binding LogDirectory, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="参照…" Command="{Binding BrowseLogCommand}" />
                    <Button Content="フォルダを開く" Command="{Binding OpenLogCommand}" />
                </StackPanel>
                <TextBlock Text="shionji-yyyyMMdd.log として日付ごとに作られます。"
                           Style="{StaticResource HintStyle}" />

                <TextBlock Text="設定" Style="{StaticResource SettingsSectionStyle}" />
                <TextBox Header="アプリ設定ファイルの保存先 (空で既定)"
                         Text="{Binding SettingsDirectory, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="参照…" Command="{Binding BrowseSettingsCommand}" />
                    <Button Content="フォルダを開く" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SettingsFileName}" Style="{StaticResource HintStyle}" />

                <TextBox Header="接続先設定ファイルの保存先 (空で既定)"
                         Text="{Binding ConfigsDirectory, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="参照…" Command="{Binding BrowseConfigsCommand}" />
                    <Button Content="フォルダを開く" Command="{Binding OpenConfigsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ConfigsFileName}" Style="{StaticResource HintStyle}" />

                <!-- 「設定ファイルの置き場所」自体は設定ファイルに書けないので、
                     この 1 ファイルだけは常に既定フォルダにある -->
                <TextBlock Style="{StaticResource HintStyle}"
                           Text="{Binding BootstrapFilePath}" IsTextSelectionEnabled="True" />
                <TextBlock Text="↑ 保存先の指定そのものはこのファイルに記録されます (移動できません)。"
                           Style="{StaticResource HintStyle}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{Binding NeedsRestart}" IsClosable="False" Severity="Informational"
                     Title="保存しました"
                     Message="保存先の変更はアプリを再起動すると反映されます。" />
            <InfoBar IsOpen="{Binding HasProblems}" IsClosable="False" Severity="Warning"
                     Title="一部反映できませんでした">
                <InfoBar.Content>
                    <ItemsControl ItemsSource="{Binding Problems}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </InfoBar.Content>
            </InfoBar>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}" />
                <Button Content="閉じる" Command="{Binding CloseCommand}"
                        Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}" />
                <Button Content="キャンセル" Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
