<Window
    x:Class="Shionji.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shionji.App.WinUI"
    Title="Shionji">

    <Grid x:Name="RootGrid" Padding="12" RowSpacing="12">
        <Grid.Resources>
            <local:StatusBrushConverter x:Key="StatusBrush" />
            <local:ActivityBrushConverter x:Key="ActivityBrush" />
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
            <local:EnumIndexConverter x:Key="EnumIndex" />

            <!-- 一覧と詳細をカードとして囲み、境界を明示する -->
            <Style x:Key="PaneStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="PaneHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="5,5,0,0" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <DataTemplate x:Key="RowTemplate">
                <Grid Height="48" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" VerticalAlignment="Center" Padding="8,4"
                                  Content="&#x23FB;"
                                  IsChecked="{Binding IsConnected, Mode=OneWay}"
                                  Command="{Binding ToggleConnectionCommand}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DetailTemplate">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Overview}" Opacity="0.8" />
                        <TextBlock Text="{Binding GatewayText}" Opacity="0.8" />
                        <TextBlock Text="{Binding DestinationText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SessionText}" />

                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                                   Foreground="IndianRed"
                                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />

                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{Binding CanSsoLogin, Converter={StaticResource BoolToVis}}">
                            <Button Content="SSO ログイン" Command="{Binding SsoLoginCommand}" />
                            <TextBlock Text="ブラウザで承認してください…" VerticalAlignment="Center"
                                       Opacity="0.7"
                                       Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Candidates}" Margin="12,0,0,0" />

                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{Binding LocalEndpoint, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding LocalEndpoint}" VerticalAlignment="Center"
                                       FontFamily="Consolas" />
                            <Button Content="コピー" Command="{Binding CopyLocalEndpointCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton Content="接続"
                                          IsChecked="{Binding IsConnected, Mode=OneWay}"
                                          Command="{Binding ToggleConnectionCommand}" />
                            <Button Content="解決を更新" Command="{Binding RefreshResolutionCommand}" />
                            <Button Content="編集" Command="{Binding EditCommand}" />
                            <Button Content="削除" Command="{Binding DeleteCommand}" />
                        </StackPanel>

                        <ListView ItemsSource="{Binding LogLines}" Height="180"
                                  FontSize="11" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="22" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <DataTemplate x:Key="EditorTemplate">
                <ScrollViewer>
                    <StackPanel Spacing="10" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBox Header="設定名" Text="{Binding Name, Mode=TwoWay}" />
                        <TextBox Header="AWS プロファイル" Text="{Binding Profile, Mode=TwoWay}" />
                        <TextBox Header="リージョン" Text="{Binding Region, Mode=TwoWay}" />
                        <TextBox Header="ローカルポート (空 = 自動割当)"
                                 Text="{Binding LocalPortText, Mode=TwoWay}" />

                        <ComboBox Header="転送先の種別" MinWidth="240"
                                  SelectedIndex="{Binding DestinationKind, Mode=TwoWay, Converter={StaticResource EnumIndex}, ConverterParameter=DestinationKind}">
                            <ComboBoxItem Content="エンドポイント / IP 直接指定" />
                            <ComboBoxItem Content="ElastiCache (検索)" />
                            <ComboBoxItem Content="Aurora (検索)" />
                            <ComboBoxItem Content="EC2 インスタンス (検索)" />
                            <ComboBoxItem Content="ECS タスク (検索)" />
                        </ComboBox>

                        <TextBox Header="転送先ホスト" Text="{Binding DestHost, Mode=TwoWay}"
                                 Visibility="{Binding IsStaticDestination, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Spacing="10"
                                    Visibility="{Binding IsNamedQueryDestination, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="名前パターン (glob: * ?)"
                                     Text="{Binding DestNamePattern, Mode=TwoWay}" />
                            <TextBox Header="タグ条件 (Key=v1|v2; Key2=v3)"
                                     Text="{Binding DestTagsText, Mode=TwoWay}" />
                        </StackPanel>

                        <ComboBox Header="エンドポイント" MinWidth="240"
                                  Visibility="{Binding IsCacheDestination, Converter={StaticResource BoolToVis}}"
                                  SelectedIndex="{Binding CacheRole, Mode=TwoWay, Converter={StaticResource EnumIndex}, ConverterParameter=CacheRole}">
                            <ComboBoxItem Content="Primary" />
                            <ComboBoxItem Content="Reader" />
                            <ComboBoxItem Content="Configuration" />
                        </ComboBox>

                        <ComboBox Header="エンドポイント" MinWidth="240"
                                  Visibility="{Binding IsAuroraDestination, Converter={StaticResource BoolToVis}}"
                                  SelectedIndex="{Binding AuroraRole, Mode=TwoWay, Converter={StaticResource EnumIndex}, ConverterParameter=AuroraRole}">
                            <ComboBoxItem Content="Writer" />
                            <ComboBoxItem Content="Reader" />
                        </ComboBox>

                        <StackPanel Spacing="10"
                                    Visibility="{Binding IsEcsTaskDestination, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="クラスター" Text="{Binding DestCluster, Mode=TwoWay}" />
                            <TextBox Header="サービス (任意)" Text="{Binding DestService, Mode=TwoWay}" />
                            <TextBox Header="コンテナ (任意)" Text="{Binding DestContainer, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBox Header="転送先ポート (ElastiCache / Aurora は空で既定ポート)"
                                 Text="{Binding DestPortText, Mode=TwoWay}" />

                        <CheckBox Content="複数一致時は先頭を採用 (PickFirst)"
                                  IsChecked="{Binding DestPickFirst, Mode=TwoWay}"
                                  Visibility="{Binding IsQueryDestination, Converter={StaticResource BoolToVis}}" />

                        <ComboBox Header="経路 (踏み台)" MinWidth="240"
                                  SelectedIndex="{Binding GatewayKind, Mode=TwoWay, Converter={StaticResource EnumIndex}, ConverterParameter=GatewayKind}">
                            <ComboBoxItem Content="直接 (転送先に SSM セッション)" />
                            <ComboBoxItem Content="EC2 踏み台 (インスタンス ID)" />
                            <ComboBoxItem Content="EC2 踏み台 (検索)" />
                            <ComboBoxItem Content="ECS 踏み台 (ECS Exec)" />
                        </ComboBox>

                        <TextBox Header="インスタンス ID" Text="{Binding GwInstanceId, Mode=TwoWay}"
                                 Visibility="{Binding IsEc2ByIdGateway, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Spacing="10"
                                    Visibility="{Binding IsEc2ByQueryGateway, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="名前パターン" Text="{Binding GwNamePattern, Mode=TwoWay}" />
                            <TextBox Header="タグ条件" Text="{Binding GwTagsText, Mode=TwoWay}" />
                            <CheckBox Content="複数一致時は先頭を採用 (PickFirst)"
                                      IsChecked="{Binding GwPickFirst, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="10"
                                    Visibility="{Binding IsEcsGateway, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="クラスター" Text="{Binding GwCluster, Mode=TwoWay}" />
                            <TextBox Header="サービス" Text="{Binding GwService, Mode=TwoWay}" />
                            <TextBox Header="コンテナ (任意)" Text="{Binding GwContainer, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Content="予期せぬ切断時に自動再接続する"
                                  IsChecked="{Binding AutoReconnect, Mode=TwoWay}" />
                        <CheckBox Content="アプリ起動時に自動接続する"
                                  IsChecked="{Binding ConnectOnLaunch, Mode=TwoWay}" />

                        <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap"
                                   Foreground="IndianRed"
                                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding SaveCommand}" />
                            <Button Content="キャンセル" Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <local:DetailTemplateSelector x:Key="DetailSelector"
                                          Detail="{StaticResource DetailTemplate}"
                                          Editor="{StaticResource EditorTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="＋ 追加" Command="{Binding AddConfigCommand}" />
            <Button Content="⟳ 全更新" Command="{Binding RefreshAllCommand}" />
            <TextBox x:Name="FilterBox" PlaceholderText="設定名でフィルタ" Width="220"
                     TextChanged="OnFilterChanged" />
            <TextBlock x:Name="DemoBadge" Text="デモモード" VerticalAlignment="Center"
                       Foreground="DarkOrange" FontWeight="SemiBold" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: 設定一覧 -->
            <Border Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PaneHeaderStyle}">
                        <TextBlock Text="{Binding ConfigsHeader}" Style="{StaticResource PaneTitleStyle}" />
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              ItemTemplate="{StaticResource RowTemplate}"
                              SelectionMode="Single" />
                </Grid>
            </Border>

            <!-- 右: 詳細 / 編集 -->
            <Border Grid.Column="1" Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PaneHeaderStyle}">
                        <TextBlock Text="{Binding DetailHeader}" Style="{StaticResource PaneTitleStyle}" />
                    </Border>

                    <Grid Grid.Row="1" Padding="12">
                        <ContentControl Content="{Binding DetailContent}"
                                        ContentTemplateSelector="{StaticResource DetailSelector}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />

                        <!-- 何も選択していないときに空白の理由を示す -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                    Visibility="{Binding DetailContent, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="設定を選択してください" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="左の一覧から選ぶと、解決結果・接続状態・ログをここに表示します"
                                       HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="320"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー: 最新の動作を 1 行で出し、そこから履歴とログファイルへ辿れる -->
        <Border Grid.Row="2" Padding="10,6" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding StatusSeverity, Converter={StaticResource ActivityBrush}}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                           Text="{Binding StatusTime}" />

                <Button Grid.Column="3" Content="ログ" Padding="10,2" FontSize="12">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel x:Name="ActivityPanel" Width="560" Spacing="8">
                                <TextBlock Text="最近の動作" FontWeight="SemiBold" />
                                <ListView ItemsSource="{Binding Activities}" MaxHeight="360"
                                          SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="Padding" Value="8,2" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Fill="{Binding Severity, Converter={StaticResource ActivityBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11"
                                                           Opacity="0.6" VerticalAlignment="Center"
                                                           FontFamily="Consolas" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{Binding LogDirectory}" FontSize="11" Opacity="0.6"
                                           TextWrapping="Wrap" />
                                <Button Content="ログフォルダを開く" HorizontalAlignment="Stretch"
                                        Command="{Binding OpenLogLocationCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
