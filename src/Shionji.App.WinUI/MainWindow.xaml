<Window
    x:Class="Shionji.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shionji.App.WinUI"
    Title="Shionji">

    <!-- Window 自体の背景はテーマ指定に追従しないため、根に明示する
         (でないとダークテーマで白背景に白文字になる) -->
    <Grid x:Name="RootGrid" Padding="12" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- 一覧の中身。カードより一段明るくして、詳細ペインと区別する -->
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ListBodyBackgroundBrush" Color="#FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ListBodyBackgroundBrush" Color="#33333A" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ListBodyBackgroundBrush"
                                         Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

            <local:StatusBrushConverter x:Key="StatusBrush" />
            <local:ActivityBrushConverter x:Key="ActivityBrush" />
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
            <local:EnumIndexConverter x:Key="EnumIndex" />

            <!-- 一覧と詳細をカードとして囲み、境界を明示する -->
            <Style x:Key="PaneStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="PaneHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="5,5,0,0" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <Style x:Key="PaneFooterStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="0,0,5,5" />
                <Setter Property="Padding" Value="8" />
            </Style>

            <!-- 文字まわりは WinUI 標準の text style を継承し、必要な差分だけを足す -->
            <Style x:Key="PaneTitleStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="FieldValueStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <DataTemplate x:Key="RowTemplate">
                <Grid Height="48" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <!-- 行は 2 行固定なので、折り返さず中央省略する -->
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <!-- 転送先を特定できていないときは、その部分だけ赤くする -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LocalText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1" Text="{Binding DestinationText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding DestinationText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="IndianRed"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DestinationHasError, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" VerticalAlignment="Center"
                                  Content="&#x23FB;"
                                  IsChecked="{Binding IsConnected, Mode=OneWay}"
                                  Command="{Binding ToggleConnectionCommand}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DetailTemplate">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBlock Text="接続先設定" Style="{StaticResource SectionHeadingStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="AWS プロファイル" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfileText}"
                                       Style="{StaticResource FieldValueStyle}" />

                            <TextBlock Grid.Row="1" Text="リージョン" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RegionText}"
                                       Style="{StaticResource FieldValueStyle}" />

                            <TextBlock Grid.Row="2" Text="経路" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GatewayText}"
                                       Style="{StaticResource FieldValueStyle}" />

                            <TextBlock Grid.Row="3" Text="転送先" Style="{StaticResource FieldLabelStyle}" />
                            <!-- 特定できていないときだけ赤い方を重ねる。
                                 Foreground を条件付きで差し替えるとテーマ既定の文字色を失う -->
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DestinationText}"
                                       Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DestinationText}"
                                       Style="{StaticResource FieldValueStyle}" Foreground="IndianRed"
                                       Visibility="{Binding DestinationHasError, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Grid.Row="4" Text="ローカル" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding LocalPortText}" FontFamily="Consolas"
                                           VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                <Button Content="コピー"
                                        Command="{Binding CopyLocalEndpointCommand}"
                                        Visibility="{Binding LocalEndpoint, Converter={StaticResource NullToVis}}" />
                                <!-- コピー完了の一時表示。表示時に既定のアニメーションで現れる -->
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="12" Padding="10,2" VerticalAlignment="Center"
                                        Visibility="{Binding IsCopyConfirmationVisible, Converter={StaticResource BoolToVis}}">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="0" FromHorizontalOffset="12" />
                                        </TransitionCollection>
                                    </Border.Transitions>
                                    <TextBlock Text="{Binding CopyConfirmationText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="状態" Style="{StaticResource SectionHeadingStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="セッション" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding SessionText}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="エラー" Style="{StaticResource FieldLabelStyle}"
                                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"
                                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                                           Foreground="IndianRed" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{Binding CanSsoLogin, Converter={StaticResource BoolToVis}}">
                                    <Button Content="SSO ログイン" Command="{Binding SsoLoginCommand}" />
                                    <TextBlock Text="ブラウザで承認してください…" VerticalAlignment="Center"
                                               Opacity="0.7"
                                               Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="一致した候補" Style="{StaticResource SectionHeadingStyle}"
                                   Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Candidates}" Margin="8,0,0,0"
                                      Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="操作" Style="{StaticResource SectionHeadingStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="接続" Command="{Binding ConnectCommand}"
                                    IsEnabled="{Binding CanConnect}" />
                            <Button Content="切断" Command="{Binding DisconnectCommand}"
                                    IsEnabled="{Binding CanDisconnect}" />
                            <Button Content="リソース再検索" Command="{Binding RefreshResolutionCommand}" />
                            <Button Content="編集" Command="{Binding EditCommand}" />
                            <!-- 取り消せない操作なので色で区別する -->
                            <Button Content="削除" Command="{Binding DeleteCommand}">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B02418" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8E1D13" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="セッションログ" Style="{StaticResource SectionHeadingStyle}"
                                   Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}" />
                        <!-- 読み取り専用のテキストとして、範囲選択して Ctrl+C できるようにする -->
                        <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" Height="180"
                                 FontFamily="Consolas" FontSize="12"
                                 IsSpellCheckEnabled="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>


            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- メニューバー: アプリ全体に対する操作。一覧固有の操作は一覧ペイン側にもある。
             既定の高さは一覧・詳細に対して大きいので詰める -->
        <MenuBar Height="30">
            <MenuBar.Resources>
                <x:Double x:Key="MenuBarHeight">30</x:Double>
                <x:Double x:Key="MenuBarItemHeight">30</x:Double>
                <Thickness x:Key="MenuBarItemButtonPadding">10,0</Thickness>
            </MenuBar.Resources>
            <MenuBarItem Title="ファイル">
                <MenuFlyoutItem Text="接続先設定を追加…" Command="{Binding AddConfigCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="終了" Click="OnExitRequested" />
            </MenuBarItem>
            <MenuBarItem Title="ツール">
                <MenuFlyoutItem Text="すべて再検索" Command="{Binding RefreshAllCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="ログフォルダを開く" Command="{Binding OpenLogLocationCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="設定…" Command="{Binding ShowSettingsCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: 設定一覧。追加は一覧への操作なので下部に置く -->
            <Border Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PaneHeaderStyle}" Padding="12,2,4,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ConfigsHeader}" VerticalAlignment="Center"
                                       Style="{StaticResource PaneTitleStyle}" />
                            <!-- 一覧全体に対する操作はここに畳む -->
                            <Button Grid.Column="1" Content="&#xE700;" ToolTipService.ToolTip="一覧の操作"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Background="Transparent" BorderThickness="0" Padding="8,4">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="すべて再検索"
                                                        Command="{Binding RefreshAllCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              ItemTemplate="{StaticResource RowTemplate}"
                              Background="{ThemeResource ListBodyBackgroundBrush}"
                              SelectionMode="Single" />
                    <Border Grid.Row="2" Style="{StaticResource PaneFooterStyle}">
                        <Button Content="＋ 接続先設定を追加" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding AddConfigCommand}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 右: 詳細 / 編集 -->
            <Border Grid.Column="1" Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PaneHeaderStyle}">
                        <TextBlock Text="{Binding DetailHeader}" Style="{StaticResource PaneTitleStyle}" />
                    </Border>

                    <!-- 中身はカードの地のまま。角丸はカードの内側に収める -->
                    <Border Grid.Row="1" Padding="12" CornerRadius="0,0,5,5">
                        <Grid>
                            <!-- Content が null でもテンプレートは適用されるため、明示的に隠す
                                 (でないと値が空のままの詳細フォームが出てしまう) -->
                            <ContentControl Content="{Binding DetailContent}"
                                            ContentTemplate="{StaticResource DetailTemplate}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Visibility="{Binding DetailContent, Converter={StaticResource NullToVis}}" />

                            <!-- 何も選択していないときに空白の理由を示す -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                        Visibility="{Binding DetailContent, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                                <TextBlock Text="接続先設定を選択してください" HorizontalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="左の一覧から選ぶと、検索結果・接続状態・ログをここに表示します"
                                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ステータスバー: 最新の動作を 1 行で出し、そこから履歴とログファイルへ辿れる。
             一覧・詳細と同じカードの扱いにして、全体背景に埋もれないようにする -->
        <Border Grid.Row="2" Padding="10,6" Style="{StaticResource PaneStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DemoBadge" Text="デモモード" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="DarkOrange" Visibility="Collapsed" />
                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding StatusSeverity, Converter={StaticResource ActivityBrush}}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{Binding StatusText}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding StatusTime}" />

                <Button Grid.Column="4" Content="ログ">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel x:Name="ActivityPanel" Width="560" Spacing="8">
                                <TextBlock Text="最近の動作" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ListView ItemsSource="{Binding Activities}" MaxHeight="360"
                                          SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="Padding" Value="8,2" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                         Fill="{Binding Severity, Converter={StaticResource ActivityBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Time}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" FontFamily="Consolas" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="ログフォルダを開く" HorizontalAlignment="Stretch"
                                        Command="{Binding OpenLogLocationCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
